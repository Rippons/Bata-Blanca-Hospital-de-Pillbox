; Bata Blanca: Hospital de Pillbox — Godot 4.5

config_version=5

[application]

config/name="Bata Blanca: Hospital de Pillbox"
config/description="El Dr. Walter Vega asciende en el Hospital de Pillbox."
run/main_scene="res://escenas/menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

Juego="*res://scripts/juego.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
